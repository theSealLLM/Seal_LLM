# .env.example을 .env로 복사해서 쓴다 (PowerShell: Copy-Item .env.example .env). .env는 커밋하지 않는다.
# 여기에는 비밀 키와 PC마다 다를 수 있는 값만 둔다. 나머지 설정은 코드 기본값을 쓴다
#   LLM · 툴 · 타임아웃: src/theseal/common/config.py (LLMConfig)
#   분류 후처리 · 검증: src/theseal/prompt/router.py (RouterConfig, 경로 규칙 기준선 RULE)
#   API · CORS: src/theseal/api/pipeline.py (ApiConfig) · 분류 모델: src/theseal/classifier/config.py (FINAL_MODEL)
# 코드 기본값을 바꾸고 싶으면 필드 이름을 대문자로 적는다 (예: max_tool_rounds → MAX_TOOL_ROUNDS=3)

# ---- 비밀 키
OPENAI_API_KEY=
# 기상청 API허브 인증키. 비우면 날씨 툴이 빠지고 검색 툴이 답한다
KMA_AUTH_KEY=
# Tavily 검색 키. 비우면 검색 툴이 빠진다
TAVILY_API_KEY=

# ---- PC 설정
OLLAMA_BASE_URL=http://localhost:11434
# VRAM 유지 시간. -1이면 계속 유지, 비우면 Ollama 기본 5분
OLLAMA_KEEP_ALIVE=
