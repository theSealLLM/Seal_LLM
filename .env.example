# .env.example을 .env로 복사해서 쓴다 (PowerShell: Copy-Item .env.example .env). .env는 커밋하지 않는다.

# ---- LLM · 답변 생성 (theseal.llm.config)
DEFAULT_PROVIDER=local
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=hf.co/unsloth/gemma-4-E4B-it-GGUF:Q4_K_M
OLLAMA_REASONING=false
OLLAMA_REASONING_WITH_TOOLS=
OLLAMA_KEEP_ALIVE=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
OPENAI_REASONING_EFFORT=
KMA_AUTH_KEY=
TAVILY_API_KEY=
TOOL_DATE_TOOLS=true
TOOL_WEATHER=true
TOOL_WEB_SEARCH=true
TOOLS_BY_LABEL={"unknown": ["date_tools", "weather", "web_search"]}
MAX_TOOL_ROUNDS=2
LLM_TIMEOUT_SEC=60
TOOL_TIMEOUT_SEC=10
# 답변 생성 한 번 전체 상한 (툴 경로의 LLM 여러 번 + 툴 포함)
ANSWER_TIMEOUT_SEC=90
TIMEZONE=Asia/Seoul

# ---- 분류 후처리 (theseal.routing.config)
ROUTE_RULE_ENABLED=true
# 모델별 보정값은 src/theseal/routing/config.py의 ROUTE_CALIBRATIONS에 있다 (calibrate_route_rule.py 출력을 붙여 넣기)
# auto: 쓰는 분류 모델의 키(<모델>/<실행 ID>) · 키를 적으면 그 항목을 쓴다
ROUTE_CALIBRATION=auto
ROUTE_TASK=inquiries
# 아래 네 값을 적으면 모든 모델에 그 값이 먼저 적용된다 (비우면 모델별 보정값 → 예시 값)
ROUTE_TEMPERATURE=
ROUTE_TAU=
ROUTE_TAU_LOW=
ROUTE_DELTA=
ROUTE_UNCERTAIN_ACTION=top1
VERIFY_MODE=uncertain
VERIFY_PROVIDER=local
VERIFY_TIMEOUT_SEC=10

# ---- FastAPI (theseal.api.pipeline)
# final: classifier/config.py FINAL_MODEL · "<모델>/<실행 ID>" · 모델 폴더 경로 (저장소 기준 상대 경로 가능)
API_CLASSIFIER=final
API_CLASSIFIER_TASK=inquiries
# 비우면 자동 (GPU가 있으면 cuda)
API_CLASSIFIER_DEVICE=
# 브라우저에서 직접 부를 프론트 주소 (쉼표 구분, *는 전부, off는 끄기). 비우면 로컬 개발 서버 5173 · 3000
API_CORS_ORIGINS=
