# .env.example을 .env로 복사해서 쓴다 (PowerShell: Copy-Item .env.example .env). .env는 커밋하지 않는다.

# ---- LLM · 답변 생성 (theseal.llm.config)
DEFAULT_PROVIDER=local
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=hf.co/unsloth/gemma-4-E4B-it-GGUF:Q4_K_M
OLLAMA_REASONING=false
OLLAMA_REASONING_WITH_TOOLS=
OLLAMA_KEEP_ALIVE=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
OPENAI_REASONING_EFFORT=
KMA_AUTH_KEY=
TAVILY_API_KEY=
TOOL_DATE_TOOLS=true
TOOL_WEATHER=true
TOOL_WEB_SEARCH=true
TOOLS_BY_LABEL={"unknown": ["date_tools", "weather", "web_search"]}
MAX_TOOL_ROUNDS=2
LLM_TIMEOUT_SEC=60
TOOL_TIMEOUT_SEC=10
TIMEZONE=Asia/Seoul

# ---- 분류 후처리 (theseal.routing.config)
ROUTE_RULE_ENABLED=true
# auto: 쓰는 분류 모델 폴더 옆 route_rule.json · "<모델>/<실행 ID>": 그 실행의 보정 파일
ROUTE_CALIBRATION=auto
ROUTE_TASK=inquiries
ROUTE_TEMPERATURE=
ROUTE_TAU=
ROUTE_TAU_LOW=
ROUTE_DELTA=
ROUTE_UNCERTAIN_ACTION=top1
VERIFY_MODE=uncertain
VERIFY_PROVIDER=local
VERIFY_TIMEOUT_SEC=10
